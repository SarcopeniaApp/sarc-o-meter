# CocoaPods — brings in MediaPipe for the Exercise feature (Features/Exercise/).
# After cloning or pulling: run `pod install`, then open **sarc-o-meter.xcworkspace**
# (NOT the .xcodeproj) so MediaPipe is linked. The rest of the app has no pods.
platform :ios, '15.0'

target 'sarc-o-meter' do
  use_frameworks!
  pod 'MediaPipeTasksVision'
end
